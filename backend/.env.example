# Datara AI Agentic Data Analyst Engine Configuration
APP_NAME=Datara Agentic Engine
APP_ENV=development
DEBUG=true
PORT=8000

# Metadata Storage (SQLite default for local, or PostgreSQL/Supabase)
DATABASE_URL=sqlite:///./datara_metadata.db

# Demo Data Source SQLite Path
DEMO_DATABASE_URL=sqlite:///./datara_demo.db

# Security & Sandbox Limits
QUERY_TIMEOUT_SECONDS=10
QUERY_MAX_ROWS=1000

# CORS Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Build APIs (REST / Client SDK)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
